{
  "name": "envca-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ENVCA - paquetería Oaxaca a EE. UU. (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "idb": "8.0.4",
    "jsbarcode": "3.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  }
}
